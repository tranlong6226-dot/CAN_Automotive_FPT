#include "vl53l0x.h"
#include "i2c.h"

#define VL53L0X_I2C_ADDR            (0x29 << 1)   /* 0x52 theo chuan STM32 HAL */
#define VL53L0X_REG_SYSRANGE_START  0x00
#define VL53L0X_REG_INT_CONFIG      0x0A
#define VL53L0X_REG_INT_CLEAR       0x0B
#define VL53L0X_REG_INT_STATUS      0x13
#define VL53L0X_REG_RANGE_RESULT    0x1E          /* RESULT_RANGE_STATUS + 10 */
#define VL53L0X_REG_MODEL_ID        0xC0          /* Gi� tri d�ng l� 0xEE */                              
#define VL53L0X_OFFSET_MM            40 			/* Nhap gia tri sai so (mm) ban vua do duoc o Buoc 2 (thuong tu 35 den 45) */
static uint8_t stop_variable = 0;

static HAL_StatusTypeDef VL53_WriteReg(uint8_t reg, uint8_t val)
{
    return HAL_I2C_Mem_Write(&hi2c1, VL53L0X_I2C_ADDR, reg,
                             I2C_MEMADD_SIZE_8BIT, &val, 1, 50);
}

static HAL_StatusTypeDef VL53_ReadReg(uint8_t reg, uint8_t *val)
{
    return HAL_I2C_Mem_Read(&hi2c1, VL53L0X_I2C_ADDR, reg,
                            I2C_MEMADD_SIZE_8BIT, val, 1, 50);
}

/* Tra ve 1 neu nhan dung dung cam bien, 0 neu loi I2C */
uint8_t VL53L0X_Init(void)
{
    uint8_t model_id = 0;
    uint8_t io_mode = 0;

    if (VL53_ReadReg(VL53L0X_REG_MODEL_ID, &model_id) != HAL_OK)
    {
        return 0;
    }
    if (model_id != 0xEE)
    {
        return 0;
    }

    /* Bat che do I/O 2.8V tuong th�ch tot voi mach breakout 3.3V */
    if (VL53_ReadReg(0x89, &io_mode) == HAL_OK)
    {
        VL53_WriteReg(0x89, io_mode | 0x01);
    }

    /* Thiet lap chuan I2C v� doc bien stop_variable noi bo */
    VL53_WriteReg(0x88, 0x00);
    VL53_WriteReg(0x80, 0x01);
    VL53_WriteReg(0xFF, 0x01);
    VL53_WriteReg(0x00, 0x00);
    VL53_ReadReg(0x91, &stop_variable);
    VL53_WriteReg(0x00, 0x01);
    VL53_WriteReg(0xFF, 0x00);
    VL53_WriteReg(0x80, 0x00);

    /* Cau h�nh co b�o khi c� mau do moi v� x�a co cu */
    VL53_WriteReg(VL53L0X_REG_INT_CONFIG, 0x04);
    VL53_WriteReg(VL53L0X_REG_INT_CLEAR, 0x01);

    return 1;
}

/* Tra ve khoang c�ch theo cm; tra ve -1.0f neu loi giao tiep */
float VL53L0X_ReadDistance_cm(void)
{
    uint8_t status = 0;
    uint8_t buf[2] = {0};
    uint32_t tick_start = 0;

    /* 1. K�ch hoat mot ph�p do don (Single-Shot) */
    VL53_WriteReg(0x80, 0x01);
    VL53_WriteReg(0xFF, 0x01);
    VL53_WriteReg(0x00, 0x00);
    VL53_WriteReg(0x91, stop_variable);
    VL53_WriteReg(0x00, 0x01);
    VL53_WriteReg(0xFF, 0x00);
    VL53_WriteReg(0x80, 0x00);

    if (VL53_WriteReg(VL53L0X_REG_SYSRANGE_START, 0x01) != HAL_OK)
    {
        return -1.0f;
    }

    /* 2. �oi bit start tu x�a (timeout 100 ms) */
    tick_start = HAL_GetTick();
    do
    {
        if (VL53_ReadReg(VL53L0X_REG_SYSRANGE_START, &status) != HAL_OK)
        {
            return -1.0f;
        }
        if ((HAL_GetTick() - tick_start) > 100)
        {
            return -1.0f;
        }
    } while (status & 0x01);

    /* 3. �oi du lieu do san s�ng (timeout 100 ms) */
    tick_start = HAL_GetTick();
    do
    {
        if (VL53_ReadReg(VL53L0X_REG_INT_STATUS, &status) != HAL_OK)
        {
            return -1.0f;
        }
        if ((HAL_GetTick() - tick_start) > 100)
        {
            return -1.0f;
        }
    } while ((status & 0x07) == 0);

    /* 4. �oc 2 byte ket qua (mm, d?nh d?ng Big-Endian) v� x�a co ngat */
    if (HAL_I2C_Mem_Read(&hi2c1, VL53L0X_I2C_ADDR, VL53L0X_REG_RANGE_RESULT,
                         I2C_MEMADD_SIZE_8BIT, buf, 2, 50) != HAL_OK)
    {
        return -1.0f;
    }
    VL53_WriteReg(VL53L0X_REG_INT_CLEAR, 0x01);

    uint16_t dist_mm = ((uint16_t)buf[0] << 8) | buf[1];
    if (dist_mm == 0)
    {
        return -1.0f;
    }
		/* Khi khong co vat can trong tam do, VL53L0X tra ve 8190 hoac 8191 mm */
    if (dist_mm >= 8190)
    {
        return 200.0f;
    }

    /* Tru bu offset, chan ve 0 de khong bi tran nguoc thanh 65535 khi di sat */
    if (dist_mm > VL53L0X_OFFSET_MM)
    {
        dist_mm -= VL53L0X_OFFSET_MM;
    }
    else
    {
        dist_mm = 0;
    }

    return (float)dist_mm / 10.0f;
}
